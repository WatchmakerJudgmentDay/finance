@page "/expenses/create"
@using Microsoft.EntityFrameworkCore
@using Finance.Models
@inject IDbContextFactory<Finance.Data.CashContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Create</PageTitle>

<h1>Create</h1>

<h2>Expense</h2>
<hr />
<div class="row">
    <div class="col-md-4">
        <EditForm method="post" Model="Expense" OnValidSubmit="AddExpense" FormName="create" Enhance>
            <DataAnnotationsValidator />
            <ValidationSummary class="text-danger" role="alert"/>
            <div class="mb-3">
                <label for="title" class="form-label">Title:</label> 
                <InputText id="title" @bind-Value="Expense.Title" class="form-control" /> 
                <ValidationMessage For="() => Expense.Title" class="text-danger" /> 
            </div>        
            <div class="mb-3">
                <label for="comments" class="form-label">Comments:</label> 
                <InputText id="comments" @bind-Value="Expense.Comments" class="form-control" /> 
                <ValidationMessage For="() => Expense.Comments" class="text-danger" /> 
            </div>        
            <div class="mb-3">
                <label for="amount" class="form-label">Amount:</label> 
                <InputNumber id="amount" @bind-Value="Expense.Amount" class="form-control" /> 
                <ValidationMessage For="() => Expense.Amount" class="text-danger" /> 
            </div>        
            <div class="mb-3">
                <label for="timeofexpense" class="form-label">TimeOfExpense:</label> 
                <InputDate id="timeofexpense" @bind-Value="Expense.TimeOfExpense" class="form-control" /> 
                <ValidationMessage For="() => Expense.TimeOfExpense" class="text-danger" /> 
            </div>        
            <button type="submit" class="btn btn-primary">Create</button>
        </EditForm>
    </div>
</div>

<div>
    <a href="/expenses">Back to List</a>
</div>

@code {
    [SupplyParameterFromForm]
    private Expense Expense { get; set; } = default!;

    protected override void OnInitialized() => Expense ??= new();

    // To protect from overposting attacks, see https://learn.microsoft.com/aspnet/core/blazor/forms/#mitigate-overposting-attacks.
    private async Task AddExpense()
    {
        using var context = DbFactory.CreateDbContext();
        context.Expenses.Add(Expense);
        await context.SaveChangesAsync();
        NavigationManager.NavigateTo("/expenses");
    }
}
